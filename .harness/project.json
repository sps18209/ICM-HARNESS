{
  "schema_version": 2,
  "requirements": [
    {
      "id": "ICM-ACCEPTANCE",
      "description": "The Python acceptance and regression suite passes; the optional authenticated live-agent smoke remains separately reported.",
      "checks": [
        "python-tests"
      ]
    },
    {
      "id": "ICM-BOUNDARIES",
      "description": "Architecture, workspace layout, and Python lint rules hold.",
      "checks": [
        "architecture",
        "layout",
        "lint"
      ]
    }
  ],
  "checks": [
    {
      "id": "python-tests",
      "argv": [
        "python",
        "-m",
        "icm_harness.evaluation.pytest_runner",
        "--report",
        ".harness/runtime/acceptance.json",
        "--",
        "tests"
      ],
      "result_format": "pytest_events",
      "report": ".harness/runtime/acceptance.json",
      "timeout_seconds": 300,
      "test_manifest": ".harness/python-tests.json"
    },
    {
      "id": "architecture",
      "argv": [
        "python",
        "scripts/validate_architecture.py"
      ]
    },
    {
      "id": "layout",
      "argv": [
        "python",
        "scripts/validate_layout.py"
      ]
    },
    {
      "id": "lint",
      "argv": [
        "python",
        "-m",
        "ruff",
        "check",
        "src",
        "tests",
        "scripts"
      ]
    }
  ],
  "protected_paths": [
    "conftest.py",
    "pyproject.toml",
    "pytest.ini",
    "scripts/capture_test_manifest.py",
    "setup.cfg",
    "src/icm_harness/evaluation/__init__.py",
    "src/icm_harness/evaluation/gates.py",
    "src/icm_harness/evaluation/profile.py",
    "src/icm_harness/evaluation/pytest_runner.py",
    "src/icm_harness/evaluation/rewards.py",
    "src/icm_harness/evaluation/runner.py",
    "src/icm_harness/evaluation/test_evidence.py",
    "tests/conftest.py",
    "tests/test_application.py",
    "tests/test_approval.py",
    "tests/test_artifacts.py",
    "tests/test_claude_agent.py",
    "tests/test_cli_server.py",
    "tests/test_codex_agent.py",
    "tests/test_codex_worktree_smoke.py",
    "tests/test_config.py",
    "tests/test_context.py",
    "tests/test_execution.py",
    "tests/test_feedback_loop.py",
    "tests/test_gates.py",
    "tests/test_init.py",
    "tests/test_intake.py",
    "tests/test_intake_eval.py",
    "tests/test_intake_picker.py",
    "tests/test_intake_resolver.py",
    "tests/test_integrations.py",
    "tests/test_lifecycle.py",
    "tests/test_mcp.py",
    "tests/test_mode_router.py",
    "tests/test_model_router.py",
    "tests/test_promotion.py",
    "tests/test_run_store.py",
    "tests/test_runtime_settings.py",
    "tests/test_state.py",
    "tests/test_test_evidence.py",
    "tests/test_typesafe_intake.py",
    "tests/test_web_intake.py",
    "tests/test_write_scope.py",
    "tests/verification_support.py",
    "tox.ini",
    "scripts/verify_project.py"
  ],
  "inherit_environment": [
    "PATH",
    "HOME",
    "LANG",
    "TMPDIR",
    "PYTHONPATH"
  ]
}
